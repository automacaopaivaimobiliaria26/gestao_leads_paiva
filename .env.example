# URL base da sua instância, sem /api no final. Ex.: https://nocodb.suaempresa.com
NOCODB_BASE_URL=
# Token de API guardado somente no servidor
NOCODB_API_TOKEN=
# IDs (Table ID) das tabelas Leads e Eventos no NocoDB
NOCODB_LEADS_TABLE_ID=
NOCODB_EVENTOS_TABLE_ID=
PORT=3000
# Prefixo usado no domínio EasyPanel, sem barra final. Use vazio para raiz.
DASHBOARD_BASE_PATH=/gestaoleads
